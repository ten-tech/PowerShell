# ================================
# System Health Monitor - .gitignore
# ================================

# Donnees generees (logs, rapports, dashboard)
logs/
reports/

# Fichiers temporaires
*.tmp
*.temp
*.bak
*.cache

# Configuration locale (ne pas commiter les secrets)
config/monitoring-config.local.json
*.local.json

# PowerShell
*.ps1xml

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# Editeurs et IDE
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Environnements virtuels
.env
.env.local
*.env

# Archives
*.zip
*.tar.gz
*.rar
*.7z
